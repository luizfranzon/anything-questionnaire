# Copy to .env before `docker compose up`.

# Postgres (used by the db service and to build the app's DATABASE_URL).
POSTGRES_USER=questionnaire
POSTGRES_PASSWORD=questionnaire
POSTGRES_DB=questionnaire

# Anthropic API key. Read from the environment only; never exposed in the UI.
ANTHROPIC_API_KEY=

# Only for running the app or the tests outside Docker (compose sets its own):
# DATABASE_URL=postgres://questionnaire:questionnaire@localhost:5432/questionnaire
# TEST_ADMIN_DATABASE_URL=postgres://questionnaire:questionnaire@localhost:5432/postgres
